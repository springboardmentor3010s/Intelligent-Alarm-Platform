# Intelligent Cognitive Alarm Platform

# Copy to .env and configure locally. Never commit .env.

# PostgreSQL connection

# Replace the placeholder with your actual database credentials.

# URL-encode special characters in the password when needed.

DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@host.docker.internal:5432/cognitive_alarm

# Frontend API URL accessible from the browser

VITE_API_URL=http://localhost:8000
