# ===================================================================
# Docker Compose & Production Environment Configuration Template
# Copy this file to .env before starting containers:
#   cp .env.example .env
# ===================================================================

# Database Settings
DB_PASSWORD=your_secure_postgres_password_here

# Backend Security
SECRET_KEY=your_secure_random_secret_key_here_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Runtime Environment (production | development)
ENVIRONMENT=production

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,https://yourdomain.com

# Frontend Build Time API URL (Optional: leave empty to use relative reverse-proxy /api)
# VITE_API_URL=https://api.yourdomain.com
