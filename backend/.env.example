# backend .env.example for Intelligent Cognitive Alarm Platform
# Copy this file to .env and fill in actual values

# Application
APP_NAME="Intelligent Cognitive Alarm Platform"
ENVIRONMENT=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
# For local dev without Docker, DATABASE_URL overrides everything below, e.g.:
#   DATABASE_URL=sqlite:///./cerebrokognit.db
# In Docker, backend/.dockerignore excludes .env from the image, so the app's
# load_dotenv(override=True) cannot clobber the Docker-injected DATABASE_URL.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cerebro_kognit
POSTGRES_USER=cerebro_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=

# Security
# WARNING: In production (ENVIRONMENT=production) a missing or placeholder
# SECRET_KEY causes an immediate startup failure.  Generate a real secret
# with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_to_a_very_random_secret_key_min_32_bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS (comma-separated list of trusted origins; wildcard ["*"] is never used)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Google OAuth2 login (Module 1) — optional. Empty = OAuth endpoints return 503
# and the sign-in buttons stay hidden, so the app runs without a Google project.
#   GOOGLE_CLIENT_ID/SECRET: a "Web application" client (web flow holds the
#     secret server-side; redirect URI = <web origin>/auth).
#   GOOGLE_MOBILE_CLIENT_ID: a public iOS/Android client for the native PKCE
#     flow (redirect URI = cerebrokognit://oauth). No secret on the device; the
#     backend only verifies the id_token audience.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/auth
GOOGLE_MOBILE_CLIENT_ID=

# ML & AI
MODEL_DIR=models
DEVICE=cpu  # auto-detect: cuda or cpu

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key_here

# Push notification delivery
#   PUSH_PROVIDER=noop  (strict no-op, raises on send — default)
#   PUSH_PROVIDER=expo  (real FCM/APNs delivery through Expo's push relay)
# EXPO_ACCESS_TOKEN is optional; leave empty in development (Expo Go ignores
# push tokens anyway — a development build is required for real delivery).
PUSH_PROVIDER=noop
EXPO_ACCESS_TOKEN=
# PUSH_EXPO_URL=https://exp.host/--/api/v2/push/send

# Expo / Mobile
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000  # Android emulator localhost

# MongoDB (optional secondary event log — PRD §4)
#   Empty = disabled: the event store silently discards events and PostgreSQL
#   remains the only required datastore (the default).
#   Local:  MONGODB_URI=mongodb://mongo:27017     (bundled compose service)
#   Cloud:  MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net
MONGODB_URI=
MONGODB_DB=cerebrokognit_events

# Error tracking (optional; unset = disabled, startup never affected)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.05